{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind Dev",
  "version": "2026.10.29",
  "identifier": "dev.mindflow.desktop.development",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mind Dev",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/development/32x32.png",
      "icons/development/128x128.png",
      "icons/development/128x128@2x.png",
      "icons/development/icon.icns",
      "icons/development/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
