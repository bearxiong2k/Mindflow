{
  "name": "mindflow-gui",
  "version": "2026.10.24",
  "private": true,
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bearxiong2k/Mindflow.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tauri build",
    "build:frontend": "tsc --noEmit && vite build",
    "icons:development": "bash scripts/generate-development-icons.sh",
    "preview": "vite preview --host 127.0.0.1",
    "local-app:identity": "bash scripts/local-app-identity.sh --print",
    "sync:local": "bash scripts/sync-local-app.sh",
    "sync:local:check": "bash scripts/sync-local-app.sh --check",
    "sync:local:launch": "bash scripts/sync-local-app.sh --launch",
    "test:frontend": "node --experimental-strip-types --test src/*.test.mjs",
    "test:local-app": "bash scripts/test-local-app-window.sh",
    "test:toolchain": "bash scripts/test-local-toolchain.sh",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dagre-d3-es": "7.0.14",
    "katex": "0.16.47",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
